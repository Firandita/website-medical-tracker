# ============================================================
# MedTrack 3T — Environment Variables
# ============================================================
# Salin file ini menjadi .env dan sesuaikan nilainya

# URL base API backend Laravel (development)
VITE_API_URL=http://localhost:8000/api

# Mode: 'true' = gunakan mock data, 'false' = gunakan API Laravel
# (saat ini toggle ada di masing-masing service file)
VITE_USE_MOCK=true
